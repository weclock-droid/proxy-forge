{
  "name": "proxy-forge",
  "version": "1.0.0",
  "private": true,
  "description": "Make your own Magic: The Gathering proxy cards in the browser.",
  "type": "module",
  "scripts": {
    "build": "node tools/build.mjs",
    "build:local": "node tools/build.mjs --local",
    "check": "node tools/build.mjs --check",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "test:headed": "PWHEADED=1 node --test \"tests/**/*.test.mjs\"",
    "refs": "node tools/dump-refs.mjs",
    "verify": "npm run check && npm test"
  },
  "devDependencies": {
    "playwright": "^1.49.0"
  }
}
